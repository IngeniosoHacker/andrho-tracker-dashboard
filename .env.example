# Server
PORT=3000
NODE_ENV=production

# Same Postgres database used by the analytics-tracker service.
# In Railway, set this as a reference to the SAME Postgres plugin:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# This dashboard only ever runs SELECT queries -- it never writes tracking data
# (except the AI-goal endpoints, which write to ai_visibility_goals only).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Comma-separated list of origins allowed to call this dashboard's API.
# Usually just the dashboard's own public URL (the browser calls same-origin,
# but set it anyway in case you split frontend/backend later).
ALLOWED_ORIGINS=*

# Shared secret used to verify JWTs issued by andrho-api (HS256). MUST match
# the value andrho-api signs tokens with, or every /api/sites/:siteId/* call
# will 401. The server refuses to start without this set.
JWT_SECRET=

# Public URL of the andrho-api Go backend (issues accounts/JWTs). Used
# server-side to inject window.ANDRHO_API_URL into public/dashboard/index.html
# so the dashboard's client-side JS can call /auth/me, /auth/refresh and
# /auth/logout directly against andrho-api.
ANDRHO_API_URL=http://localhost:8080
