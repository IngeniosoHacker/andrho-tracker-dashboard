# Base URL of the andrho-api Go backend (issues JWTs, handles signup/login).
# Point this at your local andrho-api instance during development and at its
# public Railway URL in production.
VITE_ANDRHO_API_URL=http://localhost:8080

# Whose uploaded articles /articulos/ shows next to the built ones (the
# site_id of the account that uploads them from the dashboard).
VITE_ANDRHO_SITE_ID=andrho

# The web tracker. Empty = no tracker tag at all, which is what this
# development site wants: "andrho" is production's site_id, and visits from
# here would mix into what the dashboard's Web section reports. To test the
# tracker, use a site of its own (e.g. andrho-dev), never "andrho".
VITE_TRACKER_SITE_ID=
